# Claude (bill photo parsing + promise extraction). Any SDK credential works:
# ANTHROPIC_API_KEY, ANTHROPIC_AUTH_TOKEN, or an `ant auth login` profile.
ANTHROPIC_API_KEY=
# auto | on | off  — "off" forces the deterministic fallbacks (sample bills + regex promise parser)
HOLDLESS_LLM=auto

# Tiger Data (TimescaleDB). Leave blank to use the in-memory event store.
TIGER_DATABASE_URL=

# Snowflake. Leave SNOWFLAKE_ACCOUNT blank to use the local SQLite mirror.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=HOLDLESS
SNOWFLAKE_SCHEMA=INTEL
SNOWFLAKE_ROLE=

# Local time zone used for "best time to call" (StormHacks @ SFU)
HOLDLESS_TZ=America/Vancouver
