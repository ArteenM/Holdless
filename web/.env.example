# Copy to .env.local and fill in. Anything left blank falls back to the demo.

# ElevenLabs Conversational AI, browser (web) mode. One agent per vibe;
# the person at the laptop plays the customer service rep.
ELEVENLABS_API_KEY=
EL_AGENT_POLITE=
EL_AGENT_RELENTLESS=
EL_AGENT_LAWYER=
EL_AGENT_GRANDMA=

# Arteen's data service (playbook)
DATA_API_URL=http://localhost:8100

# Solana devnet receipts (npm run solana:keygen)
SOLANA_AUTHORITY_SECRET=
SOLANA_RPC_URL=
