# Copy to .env.local and fill in. Anything left blank falls back to the demo.

# ElevenLabs Conversational AI (agent + Twilio number imported in ElevenLabs)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
# Number the agent dials, E.164 (for the demo: a teammate playing the rep)
CALL_TO_NUMBER=+1

# Arteen's data service (playbook)
DATA_API_URL=http://localhost:8100

# Solana devnet receipts (npm run solana:keygen)
SOLANA_AUTHORITY_SECRET=
SOLANA_RPC_URL=
